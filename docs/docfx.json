{
  "metadata": [
    {
      "src": [
        {
          "files": [
            "src/ArchUnitNet/**/*.cs"
          ],
          "exclude": [
            "src/ArchUnitNet/**/bin/**",
            "src/ArchUnitNet/**/obj/**"
          ]
        }
      ],
      "dest": "api",
      "disableGitFeatures": false,
      "includePrivateMembers": false,
      "includeSuperTrivialTypes": false,
      "propertyComments": true,
      "allowCompilationErrors": false
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/**.yml",
          "api/index.md"
        ]
      },
      {
        "files": [
          "articles/**.md",
          "articles/**/toc.yml",
          "toc.yml",
          "*.md"
        ]
      }
    ],
    "resources": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "overwrite": [
      {
        "files": [
          "overwrite/**.md"
        ]
      }
    ],
    "dest": "_site",
    "globalMetadata": {
      "_appFaviconPath": "favicon.ico",
      "_appTitle": "ArchUnitCSharp",
      "_appLogoPath": "logo.png",
      "_gitContribute": {
        "repo": "https://github.com/LukasNiessen/ArchUnitTS",
        "branch": "main",
        "apiSpecFolder": "docs"
      },
      "_gitUrlPattern": "github"
    },
    "fileMetadata": {},
    "template": [
      "default",
      "modern"
    ],
    "postProcessors": [],
    "noLangKeyword": false,
    "keepFileLink": false,
    "disableGitFeatures": false
  }
}
