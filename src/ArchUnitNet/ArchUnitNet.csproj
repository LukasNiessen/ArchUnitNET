<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeFrameworkVersion>8.0.29</RuntimeFrameworkVersion>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>

    <!-- NuGet Package Metadata -->
    <PackageId>ArchUnitNET</PackageId>
    <Title>ArchUnitNET</Title>
    <Description>Test-driven architecture validation for C# and .NET. Enforce layering, prevent cycles, measure cohesion, and visualize dependencies.</Description>
    <PackageProjectUrl>https://github.com/LukasNiessen/ArchUnitNET</PackageProjectUrl>
    <RepositoryUrl>https://github.com/LukasNiessen/ArchUnitNET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <LicenseUrl>https://github.com/LukasNiessen/ArchUnitNET/blob/main/LICENSE</LicenseUrl>
    <PackageTags>architecture;testing;validation;layers;cycles;metrics;cohesion;dependency;graph;rules;quality</PackageTags>
    <Authors>Lukas Niessen</Authors>
    <PackageReleaseNotes>See https://github.com/LukasNiessen/ArchUnitNET/releases for changelog</PackageReleaseNotes>
    <RepositoryBranch>main</RepositoryBranch>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="xunit" Version="2.6.6" Optional="true" />
    <PackageReference Include="NUnit" Version="4.1.0" Optional="true" />
    <PackageReference Include="MSTest.TestFramework" Version="3.6.0" Optional="true" />
  </ItemGroup>

</Project>
